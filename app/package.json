{
  "name": "truss",
  "version": "0.5.8",
  "private": true,
  "author": "kroy <kroy@kroy.io>",
  "description": "Three-pane Kubernetes management desktop app",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "icons:generate": "bash scripts/generate-icons.sh",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint:modals": "node scripts/check-modal-wrapper-usage.mjs",
    "test": "npm run lint:modals && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install",
    "preview": "vite preview",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run icons:generate && npm run build && electron-builder"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.1",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-web": "^1.7.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^28.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^4.0.18"
  }
}
