---
const year = new Date().getFullYear();
---

<footer class="border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
      <!-- Brand -->
      <div>
        <a href="/" class="font-bold text-gray-900 dark:text-white text-sm">Truss</a>
        <p class="mt-2 text-xs text-gray-500 dark:text-gray-400 leading-relaxed">
          Production-grade Kubernetes desktop for operators who want a fast GUI
          without giving up terminal habits.
        </p>
        <p class="mt-3 text-xs text-gray-400 dark:text-gray-600">
          Apache 2.0 &copy; {year} kroy
        </p>
      </div>

      <!-- Product -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Product</h3>
        <ul class="mt-3 space-y-2">
          {[
            ['Features',      '/#features'],
            ['How it Works',  '/#how-it-works'],
            ['Download',      'https://github.com/kroy-the-rabbit/truss/releases/latest'],
            ['Changelog',     'https://github.com/kroy-the-rabbit/truss/releases'],
          ].map(([label, href]) => (
            <li>
              <a
                href={href}
                class="text-sm text-gray-600 dark:text-gray-400 hover:text-teal-600 dark:hover:text-teal-400 transition-colors"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Docs & Community -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Docs & Community</h3>
        <ul class="mt-3 space-y-2">
          {[
            ['Installation',   '/docs/installation'],
            ['Quickstart',     '/docs/quickstart'],
            ['GitHub',         'https://github.com/kroy-the-rabbit/truss'],
            ['Issues',         'https://github.com/kroy-the-rabbit/truss/issues'],
            ['Discussions',    'https://github.com/kroy-the-rabbit/truss/discussions'],
            ['Security',       '/docs/security'],
            ['Contributing',   '/docs/contributing'],
          ].map(([label, href]) => (
            <li>
              <a
                href={href}
                class="text-sm text-gray-600 dark:text-gray-400 hover:text-teal-600 dark:hover:text-teal-400 transition-colors"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</footer>
