---
const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-300 bg-[#f7f8f4] dark:border-zinc-800 dark:bg-zinc-950">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
      <!-- Brand -->
      <div>
        <a href="/" class="font-black text-zinc-950 dark:text-white text-sm">Truss</a>
        <p class="mt-2 text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
          Local-first Kubernetes desktop for operators who need context before action.
        </p>
        <p class="mt-3 text-xs text-zinc-500 dark:text-zinc-600">
          Apache 2.0 &copy; {year} kroy
        </p>
      </div>

      <!-- Product -->
      <div>
        <h3 class="text-xs font-black uppercase text-zinc-500 dark:text-zinc-400">Product</h3>
        <ul class="mt-3 space-y-2">
          {[
            ['Features',      '/#features'],
            ['How it Works',  '/#how-it-works'],
            ['Download',      'https://github.com/kroy-the-rabbit/truss/releases/latest'],
            ['Changelog',     'https://github.com/kroy-the-rabbit/truss/releases'],
          ].map(([label, href]) => (
            <li>
              <a
                href={href}
                class="text-sm font-semibold text-zinc-600 dark:text-zinc-400 hover:text-teal-700 dark:hover:text-teal-300 transition-colors"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Docs & Community -->
      <div>
        <h3 class="text-xs font-black uppercase text-zinc-500 dark:text-zinc-400">Docs & Community</h3>
        <ul class="mt-3 space-y-2">
          {[
            ['Installation',   '/docs/installation'],
            ['Quickstart',     '/docs/quickstart'],
            ['GitHub',         'https://github.com/kroy-the-rabbit/truss'],
            ['Issues',         'https://github.com/kroy-the-rabbit/truss/issues'],
            ['Discussions',    'https://github.com/kroy-the-rabbit/truss/discussions'],
            ['Security',       '/docs/security'],
            ['Contributing',   '/docs/contributing'],
          ].map(([label, href]) => (
            <li>
              <a
                href={href}
                class="text-sm font-semibold text-zinc-600 dark:text-zinc-400 hover:text-teal-700 dark:hover:text-teal-300 transition-colors"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</footer>
