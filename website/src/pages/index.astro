---
import BaseLayout from '@/layouts/BaseLayout.astro';

const features = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
    title: 'Encrypted Vault',
    desc: 'Kubeconfigs and profiles are stored with AES-256-GCM (Argon2id) or GPG. Nothing goes to the cloud.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Read-Only by Default',
    desc: 'Mutations are blocked until you explicitly toggle Write mode. One less way to fat-finger production.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
    title: 'Three-Pane Layout',
    desc: 'Navigator → Resource List → Inspector. Keyboard-driven with draggable splitters and command palette.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>`,
    title: 'Logs, Exec & File Transfer',
    desc: 'Stream logs, open a shell, or transfer files — each in a persistent popout window that survives navigation.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/></svg>`,
    title: 'Cluster Overview',
    desc: 'Node readiness, pod health, and warning events in a single view. Cache warm-up indicator included.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
    title: 'Helm & GitOps',
    desc: 'Browse Helm releases, inspect values and history, and navigate ArgoCD/Flux resources natively.',
  },
];

const steps = [
  {
    n: '01',
    title: 'Download & Install',
    desc: 'Grab the AppImage, DMG, or Windows installer from GitHub Releases. No cluster agent needed.',
    code: `chmod +x truss-*.AppImage\n./truss-*.AppImage`,
  },
  {
    n: '02',
    title: 'Initialize Vault & Import Contexts',
    desc: 'Set up your encrypted vault (password or GPG), then import contexts from ~/.kube/config or paste raw YAML.',
    code: `# Truss auto-detects ~/.kube/config\n# or paste kubeconfig YAML directly in-app`,
  },
  {
    n: '03',
    title: 'Navigate in Read-Only Safety',
    desc: 'Explore your clusters in RO mode. Enable Write mode only when you intend to mutate.',
    code: `# Toggle Write mode\nCmd/Ctrl + Shift + M\n\n# Open command palette\nCmd/Ctrl + P`,
  },
];
---

<BaseLayout title="Truss">
  <!-- ─── Hero ─────────────────────────────────────────────────────────── -->
  <section
    class="relative overflow-hidden border-b border-gray-100 dark:border-gray-800"
    aria-labelledby="hero-heading"
  >
    <!-- Gradient backdrop -->
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-br from-teal-50 via-white to-white
             dark:from-gray-950 dark:via-gray-950 dark:to-gray-900"
      aria-hidden="true"
    />
    <!-- Subtle grid -->
    <div
      class="absolute inset-0 -z-10 opacity-[0.03] dark:opacity-[0.04]"
      style="background-image: linear-gradient(to right,#009090 1px,transparent 1px),linear-gradient(to bottom,#009090 1px,transparent 1px);background-size:48px 48px"
      aria-hidden="true"
    />

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-20 pb-24 sm:pt-28 sm:pb-32 text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 mb-6 px-3 py-1 rounded-full
                  border border-teal-200 dark:border-teal-800
                  bg-teal-50 dark:bg-teal-950 text-teal-700 dark:text-teal-300 text-xs font-medium">
        <span class="h-1.5 w-1.5 rounded-full bg-teal-500 animate-pulse" aria-hidden="true"></span>
        v1.0.x — Production ready
      </div>

      <!-- Heading -->
      <h1
        id="hero-heading"
        class="text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight"
      >
        <span class="bg-gradient-to-r from-teal-600 via-teal-500 to-cyan-500
                     dark:from-teal-400 dark:via-teal-300 dark:to-cyan-400
                     bg-clip-text text-transparent">
          Truss
        </span>
      </h1>

      <!-- Value prop -->
      <p class="mt-5 max-w-2xl mx-auto text-xl sm:text-2xl text-gray-600 dark:text-gray-300 font-medium leading-snug">
        Production-grade Kubernetes desktop for operators who want a fast GUI
        <span class="text-teal-600 dark:text-teal-400 font-semibold">without giving up terminal habits.</span>
      </p>

      <!-- Bullets -->
      <ul class="mt-8 max-w-lg mx-auto text-sm text-gray-500 dark:text-gray-400 space-y-2 text-left">
        {[
          'Encrypted local vault — kubeconfigs never leave your machine',
          'Read-only by default, explicit Write mode for mutations',
          'Logs, exec, file transfer, and port-forward in popout windows',
          'No cluster-side install required',
        ].map(item => (
          <li class="flex items-start gap-2">
            <svg class="mt-0.5 h-4 w-4 text-teal-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            {item}
          </li>
        ))}
      </ul>

      <!-- CTAs -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/docs/installation"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg
                 bg-teal-600 hover:bg-teal-700 active:bg-teal-800
                 text-white font-semibold text-base shadow-sm transition-colors"
        >
          Get Started
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>
        <a
          href="https://github.com/kroy-the-rabbit/truss"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg
                 border border-gray-300 dark:border-gray-700
                 text-gray-700 dark:text-gray-200 font-semibold text-base
                 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
        >
          <!-- GitHub icon -->
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          GitHub
        </a>
      </div>

      <!-- Platform badges -->
      <p class="mt-8 text-xs text-gray-400 dark:text-gray-500">
        Linux AppImage &bull; macOS DMG &bull; Windows NSIS &bull; x64 &amp; arm64
      </p>
    </div>
  </section>

  <!-- ─── Features ─────────────────────────────────────────────────────── -->
  <section
    id="features"
    class="py-20 sm:py-28 bg-gray-50 dark:bg-gray-900/50"
    aria-labelledby="features-heading"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2
          id="features-heading"
          class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white"
        >
          Everything operators need
        </h2>
        <p class="mt-3 text-lg text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
          Truss covers the full daily workflow — from context switching to deep resource inspection — without leaving your desk.
        </p>
      </div>

      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" role="list">
        {features.map(f => (
          <li class="group relative rounded-2xl border border-gray-200 dark:border-gray-800
                     bg-white dark:bg-gray-900 p-6 shadow-sm
                     hover:border-teal-300 dark:hover:border-teal-700
                     hover:shadow-md transition-all duration-200">
            <div class="mb-4 inline-flex items-center justify-center w-10 h-10
                        rounded-xl bg-teal-50 dark:bg-teal-950
                        text-teal-600 dark:text-teal-400">
              <div class="h-5 w-5" set:html={f.icon} />
            </div>
            <h3 class="font-semibold text-gray-900 dark:text-white mb-1.5">{f.title}</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">{f.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─── How it works ──────────────────────────────────────────────────── -->
  <section
    id="how-it-works"
    class="py-20 sm:py-28"
    aria-labelledby="how-heading"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2
          id="how-heading"
          class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white"
        >
          Up and running in minutes
        </h2>
        <p class="mt-3 text-lg text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
          No cluster agent to install. No service to configure. Just download, unlock, and connect.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-6 relative">
        <!-- Connector line (desktop) -->
        <div
          class="hidden lg:block absolute top-10 left-[calc(33%+1rem)] right-[calc(33%+1rem)] h-px
                 bg-gradient-to-r from-teal-300 via-teal-200 to-teal-300
                 dark:from-teal-700 dark:via-teal-800 dark:to-teal-700"
          aria-hidden="true"
        />

        {steps.map(s => (
          <div class="relative flex flex-col gap-4">
            <!-- Step number -->
            <div class="flex items-center gap-3">
              <span class="flex items-center justify-center w-10 h-10 rounded-full
                           border-2 border-teal-500 dark:border-teal-400
                           text-teal-600 dark:text-teal-400 font-bold text-sm
                           bg-white dark:bg-gray-950 z-10 shrink-0">
                {s.n}
              </span>
              <h3 class="font-semibold text-gray-900 dark:text-white">{s.title}</h3>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed pl-1">
              {s.desc}
            </p>
            <!-- Code snippet -->
            <div class="rounded-xl overflow-hidden border border-gray-200 dark:border-gray-800 text-xs">
              <div class="bg-gray-100 dark:bg-gray-800 px-3 py-1.5 flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-red-400" aria-hidden="true"/>
                <span class="h-2 w-2 rounded-full bg-yellow-400" aria-hidden="true"/>
                <span class="h-2 w-2 rounded-full bg-green-400" aria-hidden="true"/>
              </div>
              <pre class="bg-gray-900 text-gray-100 px-4 py-3 overflow-x-auto font-mono leading-relaxed"><code set:text={s.code} /></pre>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a
          href="/docs/installation"
          class="inline-flex items-center gap-2 text-sm font-medium text-teal-600 dark:text-teal-400
                 hover:text-teal-700 dark:hover:text-teal-300 transition-colors"
        >
          Full installation guide
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── CTA band ──────────────────────────────────────────────────────── -->
  <section
    class="py-16 sm:py-20 bg-teal-600 dark:bg-teal-800"
    aria-labelledby="cta-heading"
  >
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <h2
        id="cta-heading"
        class="text-2xl sm:text-3xl font-bold text-white"
      >
        Ready to replace your kubectl alias?
      </h2>
      <p class="mt-3 text-teal-100 text-lg">
        Download Truss for Linux, macOS, or Windows. Apache 2.0, free forever.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row justify-center gap-3">
        <a
          href="https://github.com/kroy-the-rabbit/truss/releases/latest"
          target="_blank"
          rel="noopener noreferrer"
          class="px-7 py-3 rounded-lg bg-white text-teal-700 font-semibold
                 hover:bg-teal-50 transition-colors shadow-sm text-base"
        >
          Download Latest Release
        </a>
        <a
          href="/docs/quickstart"
          class="px-7 py-3 rounded-lg border border-teal-300 dark:border-teal-600
                 text-white font-semibold hover:bg-teal-700 dark:hover:bg-teal-700 transition-colors text-base"
        >
          Read the Docs
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
