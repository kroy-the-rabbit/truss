---
import BaseLayout from '@/layouts/BaseLayout.astro';

const resourceGroups = [
  ['Overview', 'Cluster', ''],
  ['Workloads', 'Pods', '214'],
  ['Workloads', 'Deployments', '38'],
  ['Workloads', 'StatefulSets', '7'],
  ['Network', 'Services', '52'],
  ['Network', 'Ingresses', '11'],
  ['Packages', 'Helm Releases', '18'],
];

const resourceRows = [
  ['api-gateway-7c8d9', 'payments', 'Running', '3/3', '12m', 'ok'],
  ['ledger-writer-0', 'payments', 'Running', '2/2', '31m', 'ok'],
  ['refund-worker-6f44', 'payments', 'CrashLoopBackOff', '1/2', '4m', 'err'],
  ['stripe-egress-86bd', 'payments', 'Running', '1/1', '2h', 'ok'],
  ['public-web-77d9', 'web', 'Pending', '0/1', '55s', 'warn'],
];

const summaryFields = [
  ['Kind', 'Pod'],
  ['Namespace', 'payments'],
  ['Node', 'ip-10-42-7-19'],
  ['Ready', '3/3'],
  ['Restarts', '0'],
  ['Age', '12m'],
];

const sessionRows = [
  ['Logs', 'payments/api-gateway-7c8d9'],
  ['Exec', 'payments/refund-worker-6f44'],
  ['Port Forward', 'svc/stripe-egress 8080 -> 443'],
];

const operatorNotes = [
  {
    title: 'Built for cautious hands',
    body: 'Truss opens in read-only mode. Write mode is explicit, visible, and hard to forget when you turn it on.',
  },
  {
    title: 'Local by design',
    body: 'Kubeconfigs stay in an encrypted local vault using Argon2id/AES-256-GCM or your GPG key.',
  },
  {
    title: 'Fast without hiding kubectl',
    body: 'Logs, exec, file transfer, YAML diffing, Helm history, events, and port-forwards open as focused app windows instead of crowding the inspector.',
  },
];

const lanes = [
  ['Inspect', 'Tree, list, and inspector stay in sync while events and health keep updating.'],
  ['Intervene', 'Open logs, exec, file transfer, YAML, or port-forward in focused panes and popouts.'],
  ['Recover', 'Compare YAML, inspect Helm values, and roll back only after leaving read-only mode.'],
];
---

<BaseLayout
  title="Truss"
  description="Truss is a local-first Kubernetes desktop for operators who need a safer GUI without losing terminal-grade workflows."
>
  <section class="relative overflow-hidden border-b border-zinc-200 bg-[#f7f8f4] dark:border-zinc-800 dark:bg-zinc-950" aria-labelledby="hero-heading">
    <div class="absolute inset-0 -z-10 opacity-[0.34] dark:opacity-[0.16]" aria-hidden="true">
      <div class="h-full w-full bg-[linear-gradient(to_right,rgba(39,39,42,.12)_1px,transparent_1px),linear-gradient(to_bottom,rgba(39,39,42,.12)_1px,transparent_1px)] bg-[size:28px_28px]"></div>
    </div>

    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-4 pb-8 pt-10 sm:px-6 lg:min-h-[760px] lg:grid-cols-[0.74fr_1.26fr] lg:items-center lg:px-8 lg:pb-10 lg:pt-10">
      <div class="max-w-2xl">
        <div class="mb-6 inline-flex items-center gap-3 border-l-4 border-teal-600 bg-white px-3 py-2 text-xs font-semibold uppercase text-zinc-700 shadow-sm dark:border-teal-400 dark:bg-zinc-900 dark:text-zinc-300">
          <span>v0.8</span>
          <span class="h-1 w-1 rounded-full bg-amber-500" aria-hidden="true"></span>
          <span>Local Kubernetes desktop</span>
        </div>

        <h1 id="hero-heading" class="max-w-xl text-5xl font-black leading-[0.92] tracking-normal text-zinc-950 sm:text-6xl lg:text-7xl dark:text-white">
          Truss
        </h1>
        <p class="mt-5 max-w-xl text-xl font-semibold leading-snug text-zinc-800 sm:text-2xl dark:text-zinc-100">
          A Kubernetes workbench that starts from the way production incidents actually feel: too many panes, too much trust, not enough context.
        </p>
        <p class="mt-5 hidden max-w-xl text-base leading-7 text-zinc-600 dark:text-zinc-400 sm:block">
          Truss keeps the cluster view, resource inspector, logs, exec, YAML, Helm, and port-forwards in one local desktop app. It is read-only until you make a deliberate decision to change something.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href="https://github.com/kroy-the-rabbit/truss/releases/latest"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-md bg-zinc-950 px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-zinc-800 dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-200"
          >
            Download
          </a>
          <a
            href="/docs/quickstart"
            class="inline-flex items-center justify-center rounded-md border border-zinc-300 bg-white px-5 py-3 text-sm font-bold text-zinc-900 transition hover:border-teal-600 hover:text-teal-700 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:border-teal-400 dark:hover:text-teal-300"
          >
            Quickstart
          </a>
        </div>

        <dl class="mt-8 hidden max-w-xl grid-cols-3 border-y border-zinc-300 text-sm dark:border-zinc-800 sm:grid lg:mt-10">
          <div class="py-4 pr-3">
            <dt class="text-xs uppercase text-zinc-500 dark:text-zinc-500">Mode</dt>
            <dd class="mt-1 font-bold text-zinc-950 dark:text-white">RO first</dd>
          </div>
          <div class="border-x border-zinc-300 px-3 py-4 dark:border-zinc-800">
            <dt class="text-xs uppercase text-zinc-500 dark:text-zinc-500">Vault</dt>
            <dd class="mt-1 font-bold text-zinc-950 dark:text-white">Local</dd>
          </div>
          <div class="py-4 pl-3">
            <dt class="text-xs uppercase text-zinc-500 dark:text-zinc-500">Install</dt>
            <dd class="mt-1 font-bold text-zinc-950 dark:text-white">No agent</dd>
          </div>
        </dl>
      </div>

      <div class="relative">
        <div class="max-h-[300px] overflow-hidden rounded-md border border-[#45475a] bg-[#1e1e2e] shadow-2xl shadow-zinc-900/20 sm:max-h-none dark:border-[#45475a]">
          <div class="flex h-9 items-center justify-between border-b border-[#45475a] bg-[#181825] px-3 text-[11px] text-[#a6adc8]">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-[#7cc9ff]" aria-hidden="true"></span>
              <span class="font-bold text-[#89b4fa]">Truss</span>
              <span class="rounded-full border border-[#45475a] px-2 py-0.5 font-semibold">default</span>
            </div>
            <div class="hidden items-center gap-3 md:flex">
              <span>Context: prod-east</span>
              <span class="rounded border border-[#45475a] px-2 py-0.5">Vault</span>
              <span class="rounded border border-[#45475a] px-2 py-0.5">Preferences</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="rounded-full border border-[#89b4fa] px-2 py-0.5 font-bold text-[#89b4fa]">RO</span>
              <span class="hidden text-[#6c7086] sm:inline">Ctrl+P or : Command, / Search</span>
            </div>
          </div>

          <div class="flex h-6 items-center border-b border-[#45475a] bg-[#1e1e2e] px-3 text-[11px] text-[#a6adc8]">
            <span class="text-[#89b4fa]">prod-east</span>
            <span class="mx-1 text-[#6c7086]">/</span>
            <span>payments</span>
            <span class="mx-1 text-[#6c7086]">/</span>
            <span class="font-semibold text-[#cdd6f4]">Pods</span>
            <span class="mx-1 text-[#6c7086]">/</span>
            <span class="font-semibold text-[#cdd6f4]">api-gateway-7c8d9</span>
          </div>

          <div class="grid min-h-[500px] grid-cols-1 lg:grid-cols-[190px_minmax(250px,1fr)_minmax(280px,0.92fr)]">
            <aside class="border-b border-[#45475a] bg-[#181825] lg:border-b-0 lg:border-r">
              <div class="border-b border-[#45475a] px-3 py-2 text-xs font-bold text-[#a6adc8]">Resources</div>
              <div class="py-2 text-xs">
                {resourceGroups.map(([group, label, count], index) => (
                  <div class:list={['flex items-center justify-between px-3 py-1.5', label === 'Pods' ? 'bg-[#585b70] text-[#89b4fa]' : 'text-[#cdd6f4]']}>
                    <span class={index === 0 ? 'font-semibold' : ''}>
                      {index === 0 ? label : `${group} / ${label}`}
                    </span>
                    {count && <span class="text-[#6c7086]">{count}</span>}
                  </div>
                ))}
              </div>
            </aside>

            <section class="border-b border-[#45475a] bg-[#1e1e2e] lg:border-b-0 lg:border-r">
              <div class="flex items-center justify-between gap-3 border-b border-[#45475a] bg-[#181825] px-3 py-2 text-xs">
                <span class="font-bold text-[#a6adc8]">Namespace: payments</span>
                <span class="rounded border border-[#45475a] px-2 py-0.5 text-[#6c7086]">5/214</span>
              </div>
              <div class="flex items-center gap-2 border-b border-[#45475a] px-3 py-2 text-xs">
                <span class="font-bold text-[#89b4fa]">Pods</span>
                <span class="flex-1 rounded border border-[#45475a] bg-[#313244] px-2 py-1 text-[#6c7086]">Filter by name...</span>
                <span class="rounded-full bg-[#1f3b45] px-2 py-0.5 text-[#7cc9ff]">3</span>
                <span class="rounded-full bg-[#3f3529] px-2 py-0.5 text-[#fab387]">1</span>
                <span class="rounded-full bg-[#3c2b42] px-2 py-0.5 text-[#caa6ff]">1</span>
              </div>
              <div class="text-[11px]">
                <div class="grid grid-cols-[1.7fr_1fr_1.1fr_0.7fr] border-b border-[#45475a] bg-[#181825] px-3 py-1.5 font-bold text-[#6c7086]">
                  <span>Name</span>
                  <span>Namespace</span>
                  <span>Status</span>
                  <span class="text-right">Age</span>
                </div>
                {resourceRows.map(([name, ns, status, ready, age, state]) => (
                  <div class:list={['grid grid-cols-[1.7fr_1fr_1.1fr_0.7fr] border-b border-[#313244] px-3 py-2', name === 'api-gateway-7c8d9' ? 'bg-[#585b70] text-[#cdd6f4] outline outline-1 -outline-offset-1 outline-[#89b4fa]' : 'text-[#cdd6f4]']}>
                    <span class="truncate font-semibold">{name}</span>
                    <span class="truncate text-[#a6adc8]">{ns}</span>
                    <span class="flex items-center gap-1 truncate">
                      <span class:list={['h-1.5 w-1.5 rounded-full', state === 'ok' ? 'bg-[#7cc9ff]' : state === 'warn' ? 'bg-[#fab387]' : 'bg-[#caa6ff]']} aria-hidden="true"></span>
                      <span>{status}</span>
                      <span class="text-[#6c7086]">{ready}</span>
                    </span>
                    <span class="text-right text-[#6c7086]">{age}</span>
                  </div>
                ))}
              </div>
            </section>

            <section class="bg-[#1e1e2e]">
              <div class="border-b border-[#45475a] bg-[#181825] px-3 py-2">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0">
                    <div class="text-[11px] font-bold text-[#6c7086]">Pod</div>
                    <div class="truncate text-sm font-bold text-[#cdd6f4]">api-gateway-7c8d9</div>
                    <div class="text-[11px] text-[#a6adc8]">payments</div>
                  </div>
                  <div class="flex flex-wrap justify-end gap-1 text-[11px]">
                    {['Data', 'YAML', 'Scale', 'Restart', 'Delete'].map((action) => (
                      <span class:list={['rounded border px-2 py-1 font-semibold', action === 'Delete' ? 'border-[#caa6ff] text-[#caa6ff] opacity-40' : 'border-[#45475a] text-[#a6adc8]']}>{action}</span>
                    ))}
                  </div>
                </div>
              </div>
              <div class="flex gap-1 border-b border-[#45475a] bg-[#181825] px-3 py-2 text-xs">
                {['Summary', 'Data', 'YAML', 'Events', 'Pods'].map((tab) => (
                  <span class:list={['rounded px-2 py-1 font-semibold', tab === 'Summary' ? 'bg-[#585b70] text-[#89b4fa]' : 'text-[#a6adc8]']}>{tab}</span>
                ))}
              </div>
              <div class="p-3">
                <div class="grid grid-cols-2 gap-2 text-xs">
                  {summaryFields.map(([key, value]) => (
                    <div class="rounded border border-[#45475a] bg-[#313244] p-2">
                      <div class="text-[10px] uppercase text-[#6c7086]">{key}</div>
                      <div class="mt-1 font-semibold text-[#cdd6f4]">{value}</div>
                    </div>
                  ))}
                </div>
                <div class="mt-3 rounded border border-[#45475a] bg-[#11111b] p-3 text-[11px] leading-5 text-[#a6adc8]">
                  <div><span class="text-[#7cc9ff]">Ready</span> all containers passing probes</div>
                  <div><span class="text-[#fab387]">Event</span> one sibling pod is backoff-looping</div>
                  <div><span class="text-[#89b4fa]">Owner</span> deployment/api-gateway</div>
                </div>
              </div>
            </section>
          </div>
        </div>

        <div class="absolute -bottom-8 right-4 hidden w-[360px] rounded-md border border-[#45475a] bg-[#11111b] shadow-xl shadow-zinc-950/30 xl:block" aria-hidden="true">
          <div class="flex items-center justify-between border-b border-[#45475a] px-3 py-2 text-xs">
            <span class="font-bold text-[#cdd6f4]">Session windows</span>
            <span class="text-[#6c7086]">logs / exec / port-forward</span>
          </div>
          <div class="space-y-2 p-3 text-xs">
            {sessionRows.map(([kind, target]) => (
              <div class="flex items-center justify-between rounded border border-[#313244] bg-[#1e1e2e] px-3 py-2">
                <span class="font-semibold text-[#89b4fa]">{kind}</span>
                <span class="truncate pl-3 text-[#a6adc8]">{target}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="border-b border-zinc-200 bg-white py-14 dark:border-zinc-800 dark:bg-zinc-950" aria-labelledby="features-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[0.48fr_1fr] lg:items-start">
        <div>
          <p class="text-xs font-black uppercase text-teal-700 dark:text-teal-300">What gives it character</p>
          <h2 id="features-heading" class="mt-3 text-3xl font-black tracking-normal text-zinc-950 dark:text-white">It behaves like an operator desk, not a dashboard demo.</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {operatorNotes.map((note) => (
            <article class="border-l-4 border-zinc-900 bg-zinc-50 p-5 dark:border-zinc-600 dark:bg-zinc-900">
              <h3 class="text-base font-black text-zinc-950 dark:text-white">{note.title}</h3>
              <p class="mt-3 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{note.body}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="how-it-works" class="bg-[#f2f4f1] py-16 dark:bg-zinc-900" aria-labelledby="workflow-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <p class="text-xs font-black uppercase text-zinc-500">Daily loop</p>
          <h2 id="workflow-heading" class="mt-3 text-3xl font-black tracking-normal text-zinc-950 dark:text-white">Inspect, intervene, recover.</h2>
          <p class="mt-4 max-w-xl text-base leading-7 text-zinc-600 dark:text-zinc-400">
            The shape is intentionally boring: context on the left, resources in the middle, the thing you are touching on the right. The character comes from making the dangerous path visible.
          </p>
        </div>

        <ol class="grid gap-3">
          {lanes.map(([title, body], index) => (
            <li class="grid grid-cols-[44px_1fr] gap-4 rounded-lg border border-zinc-300 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-950">
              <span class="flex h-11 w-11 items-center justify-center rounded bg-zinc-950 text-sm font-black text-white dark:bg-white dark:text-zinc-950">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="font-black text-zinc-950 dark:text-white">{title}</h3>
                <p class="mt-1 text-sm leading-6 text-zinc-600 dark:text-zinc-400">{body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="bg-zinc-950 py-12 text-white" aria-labelledby="download-heading">
    <div class="mx-auto grid max-w-7xl gap-6 px-4 sm:px-6 md:grid-cols-[1fr_auto] md:items-center lg:px-8">
      <div>
        <h2 id="download-heading" class="text-2xl font-black tracking-normal">Ship it onto your workstation.</h2>
        <p class="mt-2 text-sm leading-6 text-zinc-400">Linux AppImage, macOS DMG, and Windows installer builds are published from signed release tags.</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="https://github.com/kroy-the-rabbit/truss/releases/latest" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-md bg-teal-400 px-5 py-3 text-sm font-black text-zinc-950 transition hover:bg-teal-300">Latest release</a>
        <a href="/docs/installation" class="inline-flex items-center justify-center rounded-md border border-zinc-700 px-5 py-3 text-sm font-black text-zinc-100 transition hover:border-zinc-400">Install docs</a>
      </div>
    </div>
  </section>
</BaseLayout>
