---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <div class="min-h-[60vh] flex flex-col items-center justify-center px-4 text-center">
    <p class="text-7xl font-extrabold text-teal-500 dark:text-teal-400 mb-4">404</p>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Page not found</h1>
    <p class="text-gray-500 dark:text-gray-400 mb-8">
      This page doesn't exist — or it moved. Check the docs or go home.
    </p>
    <div class="flex gap-4">
      <a
        href="/"
        class="px-5 py-2.5 rounded-lg bg-teal-600 hover:bg-teal-700 text-white font-medium transition-colors"
      >
        Home
      </a>
      <a
        href="/docs/installation"
        class="px-5 py-2.5 rounded-lg border border-gray-300 dark:border-gray-700
               text-gray-700 dark:text-gray-200 font-medium
               hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
      >
        Docs
      </a>
    </div>
  </div>
</BaseLayout>
